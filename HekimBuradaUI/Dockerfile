FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm install
COPY . .

ARG NEXT_PUBLIC_IDENTITY_URL
ARG NEXT_PUBLIC_MARKETPLACE_URL
ARG NEXT_PUBLIC_COMMUNITY_URL
ARG NEXT_PUBLIC_MESSAGING_URL
ARG NEXT_PUBLIC_GATEWAY_URL
ENV NEXT_PUBLIC_IDENTITY_URL=${NEXT_PUBLIC_IDENTITY_URL} \
    NEXT_PUBLIC_MARKETPLACE_URL=${NEXT_PUBLIC_MARKETPLACE_URL} \
    NEXT_PUBLIC_COMMUNITY_URL=${NEXT_PUBLIC_COMMUNITY_URL} \
    NEXT_PUBLIC_MESSAGING_URL=${NEXT_PUBLIC_MESSAGING_URL} \
    NEXT_PUBLIC_GATEWAY_URL=${NEXT_PUBLIC_GATEWAY_URL}
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /src/public ./public
COPY --from=build /src/.next/standalone ./
COPY --from=build /src/.next/static ./.next/static
EXPOSE 3000
ENTRYPOINT ["node", "server.js"]
