# HekimBurada — kök .env örneği. Yalnızca paylaşılan RabbitMQ için (bkz. docker-compose.yml).
# Her servisin KENDİ .env'i vardır (services/<Servis>/.env) — bu dosyayı kopyalamak yetmez,
# servis bazlı secret'lar için ilgili klasördeki .env.example'a da bakın.
#
# RabbitMQ kullanıcı adı/parolası burada VE her servisin appsettings.json'undaki "RabbitMq"
# bölümünde aynı olmalı — CodeGen varsayılan olarak baseforge/change_me üretiyor, bu dosya da
# onunla eşleşiyor (bkz. scripts/up.ps1).

RABBITMQ_USER=baseforge
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Frontend origin (CORS: Gateway, Identity, Messaging'in appsettings.json'unda ayrıca sabit —
# değiştirirseniz üç yerde de güncelleyin; bu satır yalnızca referans içindir).
FRONTEND_ORIGIN=http://localhost:3000
