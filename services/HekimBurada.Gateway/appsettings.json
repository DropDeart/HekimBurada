{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5436;Database=hekimburada_gateway_db;Username=baseforge;Password=change_me"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "ReverseProxy": {
    "Routes": {
      "marketplace-route": {
        "ClusterId": "marketplace-cluster",
        "Match": { "Path": "/api/gateway/marketplace/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/gateway/marketplace" }, { "PathPrefix": "/api" } ]
      },
      "community-route": {
        "ClusterId": "community-cluster",
        "Match": { "Path": "/api/gateway/community/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/gateway/community" }, { "PathPrefix": "/api" } ]
      },
      "messaging-route": {
        "ClusterId": "messaging-cluster",
        "Match": { "Path": "/api/gateway/messaging/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/gateway/messaging" }, { "PathPrefix": "/api" } ]
      }
    },
    "Clusters": {
      "marketplace-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://host.docker.internal:5100/" }
        }
      },
      "community-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://host.docker.internal:5110/" }
        }
      },
      "messaging-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://host.docker.internal:5120/" }
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Grpc": {
    "Identity": "http://host.docker.internal:5091"
  },
  "Serilog": {
    "LokiUrl": "http://host.docker.internal:3100"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
