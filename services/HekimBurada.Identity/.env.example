# Format referansı — gerçek değerler otomatik '.env'e yazıldı (bu dosya git'e commit edilebilir).
# docker-compose 'env_file' ile, yerel 'dotnet run' DotNetEnv ile bu formatı okur.

Auth__SeedAdmin__Password=

# Dış sağlayıcı secret'ları (kullanılacaksa):
Auth__Providers__Google__ClientSecret=
Auth__Providers__GitHub__ClientSecret=
Auth__Providers__Microsoft__ClientSecret=
Auth__Providers__Facebook__ClientSecret=
# Apple: .p8 dosyasının içeriği (gerçek satır sonu yerine \n kaçış dizisiyle tek satırda)
Auth__Providers__Apple__PrivateKey=
